PORT=5001
HOST=0.0.0.0
FRONTEND_PORT=5173
# Optional: add exact LAN frontend origins if needed.
# Example: FRONTEND_ORIGINS=http://192.168.1.42:5173
FRONTEND_ORIGINS=
# Behind nginx/Heroku etc.: set so rate limits use the real client IP (optional).
# TRUST_PROXY=1
MONGO_URI=mongodb://127.0.0.1:27017/sesh_tracker
JWT_SECRET=change_this_to_a_long_random_string_in_production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Frontend API target:
# - Desktop local default can stay localhost.
# - For iPhone testing, set your Mac LAN IP (same Wi-Fi), e.g.:
#   VITE_API_URL=http://192.168.1.42:5001
# - For production later, set your deployed API URL.
VITE_API_URL=http://localhost:5001
